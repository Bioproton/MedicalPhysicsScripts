* Black hole
BLKBODY      5 +blkbody -void
* Void around
VOID         5 +void -voidbox1-voidbox2-voidbox3-voidbox4-voidbox5
VOID21       5 +voidbox1
               -bar1_1-bar1_2-bar1_3-bar1_4
               -bar2_1-bar2_2-bar2_3-bar2_4
               -bar3_1-bar3_2-bar3_3-bar3_4
